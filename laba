void Bi(uint32_t u) {
    for (int i = 31; i >= 0; --i) {
        cout << ((u >> i) & 1);
        if (i == 31) cout << " | ";
        else if (i % 8 == 0 && i != 0) cout << ' ';
    }
    cout << endl;
}

void Fl(float f) {
    uint32_t bits;
    memcpy(&bits, &f, sizeof(bits));

    int sign = bits >> 31;
    int expo = (bits >> 23) & 0xFF;
    uint32_t mant = bits & 0x7FFFFF;

    cout << "значение: " << f << endl;
    cout << "знак: " << sign << endl;
    cout << "порядокк: ";
    for (int i = 30; i >= 23; --i) cout << ((bits >> i) & 1);
    cout << " (" << expo << ")" << endl;
    cout << "мантисса: ";
    for (int i = 22; i >= 0; --i) cout << ((bits >> i) & 1);
    cout << endl;
    if (expo == 0 && mant != 0) cout << "денормализованное  число" << endl;
}

void Da(double d) {
    uint64_t bits;
    memcpy(&bits, &d, sizeof(bits));

    int sign = bits >> 63;
    int expo = (bits >> 52) & 0x7FF;
    uint64_t mant = bits & 0xFFFFFFFFFFFFFULL;

    cout << "значение: " << d << endl;
    cout << "знак: " << sign << endl;
    cout << "порядок: ";
    for (int i = 62; i >= 52; --i) cout << ((bits >> i) & 1);
    cout << " (" << expo << ")" << endl;
    cout << "мантисса: ";
    for (int i = 51; i >= 0; --i) cout << ((bits >> i) & 1);
    cout << endl;
    if (expo == 0 && mant != 0) cout << "денормализованное число" << endl;
}

uint32_t B32(uint32_t value, int k, int op) {
    if (op == 1) value |= (1u << k);
    if (op == 2) value &= ~(1u << k);
    if (op == 3) value ^= (1u << k);
    return value;
}

uint64_t B64(uint64_t value, int k, int op) {
    if (op == 1) value |= (1ULL << k);
    if (op == 2) value &= ~(1ULL << k);
    if (op == 3) value ^= (1ULL << k);
    return value;
}

